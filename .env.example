# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Local fixtures are available only when Firebase emulators are enabled.
VITE_USE_FIREBASE_EMULATORS="false"
VITE_LOAD_DEMO_DATA="false"
VITE_ENABLE_PWA_DEV="false"

# Optional Firebase target overrides. Leave unset to use firebase-applet-config.json.
# For staging, copy these values from the staging Firebase web app and create the
# same named Firestore database configured in firebase.json. Functions read
# FIRESTORE_DATABASE_ID and FUNCTIONS_STORAGE_BUCKET from their project env file.
# VITE_FIREBASE_PROJECT_ID="your-staging-project-id"
# VITE_FIREBASE_API_KEY="your-staging-web-api-key"
# VITE_FIREBASE_APP_ID="your-staging-web-app-id"
# VITE_FIREBASE_AUTH_DOMAIN="your-staging-project-id.firebaseapp.com"
# VITE_FIREBASE_STORAGE_BUCKET="your-staging-project-id.firebasestorage.app"
# VITE_FIREBASE_MESSAGING_SENDER_ID="your-staging-sender-id"
# VITE_FIREBASE_MEASUREMENT_ID=""
# VITE_FIREBASE_OAUTH_CLIENT_ID="your-staging-oauth-client-id"
# VITE_FIREBASE_RECAPTCHA_SITE_KEY="your-staging-recaptcha-site-key"
# VITE_FIRESTORE_DATABASE_ID="ai-studio-sipmisionessiste-84140521-dd09-4717-8340-b1ed25aa1dd7"
